# Public browser configuration
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

# Server-only credentials
SUPABASE_SERVICE_ROLE_KEY=replace_me
RESEND_API_KEY=replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
UNSUBSCRIBE_SECRET=replace_with_at_least_32_random_characters
CRON_SECRET=replace_with_a_long_random_value
NOWPAYMENTS_API_KEY=replace_me
NOWPAYMENTS_IPN_SECRET=replace_me
SUMSUB_APP_TOKEN=replace_me
SUMSUB_SECRET_KEY=replace_me
SUMSUB_WEBHOOK_SECRET=replace_me

# Optional account-migration target. Keep real values in the deployment secret
# store; never commit customer identifiers or wallet addresses.
MIGRATION_TARGET_USER_ID=
MIGRATION_TARGET_EVM_WALLET=
